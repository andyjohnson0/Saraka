<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Enable trim analyzers for Android class libraries.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/prepare-libraries-for-trimming
    -->
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Saraka.AndroidSaf</RootNamespace>
    <Version>0.3.0</Version>
    <Authors>Andrew Johnson</Authors>
    <Description>A read-only Saraka file system backed by an Android Storage Access Framework document tree, such as a folder chosen with the system folder picker. Requires Android 13 (API 33) or later.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/andyjohnson0/Saraka</PackageProjectUrl>
    <RepositoryUrl>https://github.com/andyjohnson0/Saraka</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Saraka.Abstractions\Saraka.Abstractions.csproj" />
  </ItemGroup>
</Project>